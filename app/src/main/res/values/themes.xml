<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tmavé jako Kine na každém telefonu (dřív DeviceDefault - u některých výrobců nečitelné). -->
    <style name="Kine" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/card</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:colorControlActivated">@color/brand</item>
        <item name="android:colorControlNormal">@color/dim</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/dim</item>
    </style>
</resources>
